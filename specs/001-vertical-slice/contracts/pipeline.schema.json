{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketdataforge.org/schemas/v1/pipeline.schema.json",
  "title": "RocketDataForge Pipeline Declarative Schema",
  "description": "Esquema normativo para validação semântica de arquivos pipeline.yaml.",
  "type": "object",
  "required": ["schemaVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "rdf.pipeline/v1",
      "description": "Versão estável do formato declarativo de pipeline."
    },
    "kind": {
      "type": "string",
      "const": "Pipeline",
      "description": "Identificador do tipo de recurso declarativo."
    },
    "metadata": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Identificador alfanumérico único do pipeline."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Nome legível do pipeline."
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["string", "int", "float", "boolean", "secretRef"] },
              "default": {},
              "description": { "type": "string" }
            }
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "component", "config"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$",
                "description": "Identificador único do nó no grafo."
              },
              "component": {
                "type": "object",
                "required": ["type", "version"],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Identificador do componente (ex: core.database.source, core.filter)"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                  }
                }
              },
              "config": {
                "type": "object",
                "description": "Configurações específicas validadas pelo JSON Schema do componente."
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "from": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+$",
                "description": "Formato: <node_id>.<port_name>"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+$",
                "description": "Formato: <node_id>.<port_name>"
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engine": {
              "type": "string",
              "enum": ["auto", "duckdb", "polars"],
              "default": "auto"
            },
            "chunk_size": {
              "type": "integer",
              "minimum": 100,
              "maximum": 1000000,
              "default": 10000
            },
            "parallelism": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean", "default": false },
                "workers": { "type": "integer", "minimum": 1, "maximum": 64, "default": 2 }
              }
            }
          }
        }
      }
    }
  }
}
